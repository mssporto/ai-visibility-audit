---
import { SITE_NAME, SITE_DESCRIPTION } from "@/consts.ts";
import { Image } from "astro:assets";
import Isotype from "@/assets/isotype.png";
---

<footer class="footer_wrap">
  <div class="footer_inner">
    <div class="footer_top">
      <div>
        <a class="footer_logo" href="/" aria-label={SITE_NAME}>
					<Image src={Isotype} alt="" width={96} height={187} class="footer_logo_icon" />
				</a>
        <p class="footer_tagline">{SITE_DESCRIPTION}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="footer_links">
          <li><a class="footer_link" href="https://dahiana.work" target="_blank" rel="noopener noreferrer">Built by Dahiana</a></li>
          <li><a class="footer_link" href="/cookies">Cookies</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer_bottom">
      <p class="footer_copyright text-style-small">
				&copy; <span id="year">{new Date().getFullYear()}</span>&#160;{
					SITE_NAME
				}
			</p>
    </div>
  </div>
</footer>

<script>
	const year = document.querySelector<HTMLSpanElement>("#year");

	if (year) {
		year.textContent = new Date().getFullYear().toString();
	}
</script>

<style is:global>
	@layer components {
		.footer_wrap {
			display: flex;
			justify-content: center;
			padding-block: var(--section-space-small);
			padding-inline: var(--site-margin);
			background-color: var(--background-2);
			color: var(--text);
			border-top: var(--border-width) solid var(--border);
			opacity: 1;
		}

		.footer_inner {
			width: 100%;
			max-width: var(--max-width-main);
			display: flex;
			flex-direction: column;
			gap: var(--space-6);
		}

		.footer_top {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-4) var(--space-6);
		}

		/* Icon-only logo (no wordmark): the approved isotype (raster PNG, hence
		   Image rather than Icon/SVG). */
		.footer_logo {
			display: inline-flex;
			align-items: center;
			color: var(--text);
			text-decoration: none;
			transition: opacity 200ms;
			@media (hover: hover) {
				&:hover {
					opacity: 0.6;
				}
			}
		}

		.footer_logo_icon {
			display: block;
			width: auto;
			height: 1.5rem;
		}

		.footer_tagline {
			color: var(--text-faded);
			margin-top: var(--space-1);
		}

		.footer_links {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-4);
			margin: 0;
			padding: 0;
			list-style: none;
			font-size: var(--text-small);
			font-weight: var(--primary-medium);
		}

		.footer_link {
			display: inline-flex;
			align-items: center;
			min-height: 2.75rem;
			color: var(--text-faded);
			text-decoration: none;
			transition: color 200ms;
			@media (hover: hover) {
				&:hover {
					color: var(--text);
				}
			}
		}

		.footer_bottom {
			padding-top: var(--space-4);
			border-top: var(--border-width) solid var(--border);
			display: flex;
			justify-content: center;
		}

		.footer_copyright {
			color: var(--text-faded);
		}
	}
</style>

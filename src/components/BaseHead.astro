---
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
	title,
	description = SITE_DESCRIPTION,
	image = "/og-image.png",
	type = "website",
	noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const logoUrl = new URL("/apple-touch-icon.png", Astro.site);

// Organization + WebSite JSON-LD: this tool audits other sites for exactly
// this signal, so it ships its own rather than being a structured-data
// category it fails on its own checklist. Only the fields the checklist
// itself asks for (name, url, logo, sameAs) plus WebSite's own name/url.
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			name: SITE_NAME,
			url: SITE_URL,
			logo: logoUrl.toString(),
			sameAs: ["https://dahiana.work"],
		},
		{
			"@type": "WebSite",
			name: SITE_NAME,
			url: SITE_URL,
			description: SITE_DESCRIPTION,
		},
	],
};
---

<meta charset="utf-8" />
<style is:inline>
	@layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

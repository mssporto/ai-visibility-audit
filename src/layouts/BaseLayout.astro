---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
	/**
	 * Fix the nav over the page rather than letting it stick in flow, so the
	 * first section starts underneath it. Give that section
	 * `paddingTop="navoverlap"` to clear the bar.
	 */
	overlap?: boolean;
};

const { overlap = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...seo} />
	</head>
	<body>
		<SkipLink />
		<Nav overlap={overlap} />
		{
			/* `tabindex` so the jump moves focus here, not just the scroll position */
		}
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

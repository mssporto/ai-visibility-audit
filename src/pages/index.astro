---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="AI Visibility Audit"
	description="A free AEO/GEO visibility audit — paste a URL, get your score."
>
	<section class="landing">
		<div class="corner-widget corner-widget--clock" id="corner-clock" aria-hidden="true"></div>

		<div class="landing__inner">
			<h1 class="landing__heading">AI Visibility Audit</h1>
			<p class="landing__sub">
				Check how visible your site is to AI search and answer engines — free, instant.
			</p>

			<form id="checkin-form" class="input-group" novalidate>
				<label for="url-input" class="input-group__label">Site URL</label>
				<div class="input-group__row">
					<input
						type="url"
						id="url-input"
						name="url"
						class="input-group__field"
						placeholder="https://example.com"
						required
					/>
					<button type="submit" id="checkin-submit" class="input-group__button">
						Run audit
					</button>
				</div>
				<p id="checkin-status" class="landing__status" role="status"></p>
			</form>
		</div>
	</section>

	<script>
		import "../scripts/home-ui";
	</script>

	<style>
		.landing {
			min-height: calc(100vh - 8rem);
			display: flex;
			align-items: center;
			justify-content: center;
			padding: var(--space-4) var(--space-3);
			position: relative;
		}

		.corner-widget {
			position: absolute;
			top: var(--space-3);
			right: var(--space-3);
			font-family: var(--font-body);
			font-size: var(--text-micro);
			font-weight: 600;
			letter-spacing: 0.06em;
			color: var(--ink-secondary);
			font-variant-numeric: tabular-nums;
		}

		.landing__inner {
			max-width: var(--content-max-width);
			width: 100%;
			text-align: center;
		}

		.landing__heading {
			font-size: var(--text-display);
			font-weight: 800;
			letter-spacing: -0.02em;
			color: var(--ink);
			margin: 0 0 var(--space-2);
			text-wrap: balance;
		}

		.landing__sub {
			font-size: var(--text-body);
			color: var(--ink-secondary);
			margin: 0 0 var(--space-4);
			text-wrap: pretty;
		}

		.input-group {
			text-align: left;
		}

		.input-group__label {
			display: block;
			font-size: var(--text-small);
			font-weight: 600;
			color: var(--ink-secondary);
			margin-bottom: var(--space-1);
		}

		.input-group__row {
			display: flex;
			gap: var(--space-2);
		}

		.input-group__field {
			flex: 1;
			font-family: var(--font-body);
			font-size: var(--text-body);
			background: var(--surface);
			color: var(--ink);
			border: 1px solid var(--border);
			border-radius: var(--radius);
			padding: var(--space-2);
		}
		.input-group__field::placeholder {
			color: var(--ink-secondary);
		}
		.input-group__field:focus-visible {
			outline: none;
			border-color: var(--ink);
			box-shadow: 0 0 0 1px var(--ink);
		}

		.input-group__button {
			font-family: var(--font-body);
			font-weight: 700;
			font-size: var(--text-body);
			background: var(--ink);
			color: var(--surface);
			border: none;
			border-radius: var(--radius);
			padding: var(--space-2) var(--space-4);
			transition: filter 150ms ease;
			white-space: nowrap;
		}
		.input-group__button:hover {
			filter: brightness(1.3);
		}
		.input-group__button:active {
			filter: brightness(0.9);
		}
		.input-group__button:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}

		.landing__status {
			font-size: var(--text-small);
			color: var(--ink-secondary);
			min-height: 1.2em;
			margin: var(--space-2) 0 0;
		}

		@media (max-width: 480px) {
			.input-group__row {
				flex-direction: column;
			}
			.corner-widget {
				display: none;
			}
		}
	</style>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ContentWrapper from '@/components/ContentWrapper.astro';
---

<BaseLayout description="A free AEO/GEO visibility audit. Paste a URL, get your score." title="Free AEO & GEO Visibility Audit">
  <Section align="center" paddingTop="even" class="landing" fullHeight={true} paddingBottom="even">
    <ContentWrapper centered={true}>

      <Heading tag="h1" class="landing__heading">AI Visibility Audit</Heading>
      <Paragraph class="landing__sub">
			Check how visible your site is to AI search and answer engines: free and instant.
		</Paragraph>
    </ContentWrapper>

    <form id="checkin-form" class="input-group" novalidate>
      <label for="url-input" class="input-group__label">Site URL</label>
      <div class="input-group__row">
        <input
					type="url"
					id="url-input"
					name="url"
					class="input-group__field"
					placeholder="https://example.com"
					required
				/>
        <Button id="checkin-submit" type="submit">Run audit</Button>
      </div>
      <p id="checkin-status" class="landing__status" role="status"></p>
    </form>
  </Section>

  <script>
		import "../scripts/home-ui";
  </script>

  <style>
		:global(.landing) {
			min-height: calc(100svh - var(--nav-height));
			justify-content: center;
			position: relative;
		}
		:global(.landing .container) {
			max-width: var(--content-max-width);
			text-align: center;
		}

		:global(.landing__heading) {
			font-size: var(--text-display);
			letter-spacing: var(--letter-spacing-tight);
			text-wrap: balance;
		}

		:global(.landing__sub) {
			font-size: var(--text-body);
			color: var(--text-faded);
			text-wrap: pretty;
		}

		.input-group {
			text-align: left;
			width: 100%;
		}

		.input-group__label {
			display: block;
			font-size: var(--text-small);
			font-weight: var(--primary-bold);
			color: var(--text-faded);
			margin-bottom: var(--space-1);
		}

		.input-group__row {
			display: flex;
			gap: var(--space-2);
		}

		.input-group__field {
			flex: 1;
			font-family: var(--primary-family);
			font-size: var(--text-body);
			background: var(--background-2);
			color: var(--text);
			border: var(--border-width) solid var(--border);
			border-radius: var(--radius-small);
			padding: var(--space-2);
		}
		.input-group__field::placeholder {
			color: var(--text-faded);
		}
		.input-group__field:focus-visible {
			outline: none;
			border-color: var(--text);
			box-shadow: 0 0 0 1px var(--text);
		}

		.landing__status {
			font-size: var(--text-small);
			color: var(--text-faded);
			min-height: 1.2em;
			margin: var(--space-2) 0 0;
		}

		@media (max-width: 480px) {
			.input-group__row {
				flex-direction: column;
			}
		}
  </style>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout description="A free AEO/GEO visibility audit — paste a URL, get your score.">
	<Section
		align="center"
		paddingTop="even"
		paddingBottom="even"
		fullHeight
		class="landing"
	>
		<div
			class="corner-widget corner-widget--clock"
			id="corner-clock"
			aria-hidden="true"
		>
		</div>

		<Heading tag="h1" class="landing__heading">AI Visibility Audit</Heading>
		<Paragraph class="landing__sub">
			Check how visible your site is to AI search and answer engines — free, instant.
		</Paragraph>

		<form id="checkin-form" class="input-group" novalidate>
			<label for="url-input" class="input-group__label">Site URL</label>
			<div class="input-group__row">
				<input
					type="url"
					id="url-input"
					name="url"
					class="input-group__field"
					placeholder="https://example.com"
					required
				/>
				<Button type="submit" id="checkin-submit">Run audit</Button>
			</div>
			<p id="checkin-status" class="landing__status" role="status"></p>
		</form>
	</Section>

	<script>
		import "../scripts/home-ui";
	</script>

	<style>
		:global(.landing) {
			min-height: calc(100svh - var(--nav-height));
			justify-content: center;
			position: relative;
		}
		:global(.landing .container) {
			max-width: var(--content-max-width);
			text-align: center;
		}

		.corner-widget {
			position: absolute;
			top: var(--space-3);
			right: var(--space-3);
			font-family: var(--primary-family);
			font-size: var(--text-micro);
			font-weight: var(--primary-bold);
			letter-spacing: 0.06em;
			color: var(--text-faded);
			font-variant-numeric: tabular-nums;
		}

		:global(.landing__heading) {
			font-size: var(--text-display);
			letter-spacing: var(--letter-spacing-tight);
			text-wrap: balance;
		}

		:global(.landing__sub) {
			font-size: var(--text-body);
			color: var(--text-faded);
			text-wrap: pretty;
		}

		.input-group {
			text-align: left;
			width: 100%;
		}

		.input-group__label {
			display: block;
			font-size: var(--text-small);
			font-weight: var(--primary-bold);
			color: var(--text-faded);
			margin-bottom: var(--space-1);
		}

		.input-group__row {
			display: flex;
			gap: var(--space-2);
		}

		.input-group__field {
			flex: 1;
			font-family: var(--primary-family);
			font-size: var(--text-body);
			background: var(--background-2);
			color: var(--text);
			border: var(--border-width) solid var(--border);
			border-radius: var(--radius-small);
			padding: var(--space-2);
		}
		.input-group__field::placeholder {
			color: var(--text-faded);
		}
		.input-group__field:focus-visible {
			outline: none;
			border-color: var(--text);
			box-shadow: 0 0 0 1px var(--text);
		}

		.landing__status {
			font-size: var(--text-small);
			color: var(--text-faded);
			min-height: 1.2em;
			margin: var(--space-2) 0 0;
		}

		@media (max-width: 480px) {
			.input-group__row {
				flex-direction: column;
			}
			.corner-widget {
				display: none;
			}
		}
	</style>
</BaseLayout>

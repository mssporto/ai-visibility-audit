---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Results" description="AEO/GEO visibility audit results.">
  <Section paddingTop="small" paddingBottom="small" class="results">
    <div class="results__inner">
      <div id="loading-state" class="loading-state">
        <p class="loading-state__text">
					Checking <span id="loading-url" class="loading-state__url"></span>…
				</p>
      </div>

      <div id="error-state" class="error-state" hidden role="alert">
        <p id="error-message" class="error-state__message"></p>
        <ButtonWrapper class="alignment-center">
          <Button element="link" href="/" variant="link" class="cta-link">
						← Back to audit
					</Button>
        </ButtonWrapper>
      </div>

      <div id="dashboard" class="dashboard" hidden>
        <p id="blocked-banner" class="blocked-banner" hidden role="alert"></p>

        <div class="score-cards">
          <div class="score-card">
            <span class="score-card__label">AEO score</span>
            <span id="aeo-score" class="score-card__value">…</span>
            <div class="progress-bar">
              <div id="aeo-bar" class="progress-bar__fill"></div>
            </div>
          </div>
          <div class="score-card">
            <span class="score-card__label">GEO score</span>
            <span id="geo-score" class="score-card__value">…</span>
            <div class="progress-bar">
              <div id="geo-bar" class="progress-bar__fill"></div>
            </div>
          </div>
        </div>

        <p id="verdict-line" class="dashboard__verdict"></p>

        <div class="results-panel">
          <Heading tag="h2" class="results-panel__heading">Detailed breakdown</Heading>
          <p class="results-panel__hint">
						Click a row to see what it checks, why it matters, and the sources behind it.
					</p>
          <div id="category-rows" class="category-rows"></div>
        </div>

        <div class="results-panel results-panel--secondary">
          <Heading tag="h2" class="results-panel__heading">Also checked</Heading>
          <p class="results-panel__hint">
						Not part of either score. Shown for context anyway.
					</p>
          <div id="also-checked-rows" class="category-rows"></div>
        </div>

        <ButtonWrapper>
          <Button element="link" href="/" variant="link" class="cta-link">
						Run another audit →
					</Button>
        </ButtonWrapper>

        <p class="disclaimer">
					This is a free personal project, not a professional SEO service. Scores are
					an opinionated heuristic, not an industry standard or a guarantee of AI
					visibility, and search/AI ranking factors change constantly. For a real
					strategy, work with an SEO professional.
				</p>
      </div>
    </div>
  </Section>

  <script>
		import "../scripts/results-ui";
  </script>

  <style>
		:global(.results) {
			flex: 1;
		}

		:global(.results .container) {
			max-width: var(--dashboard-max-width);
		}

		.results__inner {
			width: 100%;
		}

		/* Button's "link" variant is deliberately thin (no min-height); this
		   restores the 44px touch target without editing the shared component. */
		:global(.cta-link) {
			min-height: 2.75rem;
		}

		.loading-state {
			text-align: center;
			padding: var(--space-8) 0;
			color: var(--text-faded);
			font-size: var(--text-body);
		}
		.loading-state__url {
			color: var(--text);
			font-weight: var(--primary-bold);
			word-break: break-all;
		}

		.error-state {
			text-align: center;
			padding: var(--space-8) var(--space-3);
			background: var(--error-background);
			border: var(--border-width) solid var(--error);
			border-radius: var(--radius-small);
		}
		.error-state__message {
			color: var(--error);
			font-weight: var(--primary-bold);
			margin: 0 0 var(--space-2);
		}

		.blocked-banner {
			background: var(--error-background);
			color: var(--error);
			border: var(--border-width) solid var(--error);
			border-radius: var(--radius-small);
			padding: var(--space-2) var(--space-3);
			font-weight: var(--primary-bold);
			margin: 0 0 var(--space-3);
		}

		.score-cards {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: var(--space-3);
			margin-bottom: var(--space-4);
		}

		.score-card {
			background: var(--background-2);
			border: 2px solid var(--text);
			border-radius: var(--radius-small);
			padding: var(--space-3);
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: var(--space-1);
		}

		.score-card__label {
			font-size: var(--text-small);
			font-weight: var(--primary-bold);
			color: var(--text-faded);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.score-card__value {
			font-size: var(--text-score);
			font-weight: var(--primary-bold);
			line-height: var(--line-height-small);
			color: var(--text);
		}

		.progress-bar {
			width: 100%;
			height: 0.5rem;
			background: var(--border);
			border-radius: var(--radius-round);
			overflow: hidden;
			margin-top: var(--space-1);
		}

		:global(.progress-bar__fill) {
			height: 100%;
			border-radius: var(--radius-round);
			background: var(--success);
			transition: width 400ms cubic-bezier(0.16, 1, 0.3, 1);
		}
		:global(.progress-bar__fill[data-status="fail"]) {
			background: var(--error);
		}

		.dashboard__verdict {
			font-size: var(--text-body);
			color: var(--text-faded);
			text-align: center;
			margin: 0 0 var(--space-4);
		}

		.results-panel {
			background: var(--background-2);
			border: var(--border-width) solid var(--border);
			border-radius: var(--radius-small);
			padding: var(--space-4);
			margin-bottom: var(--space-4);
		}

		.results-panel--secondary {
			background: var(--background);
			border-style: dashed;
		}

		:global(.results-panel__heading) {
			font-size: var(--text-title);
			letter-spacing: var(--letter-spacing-tight);
			margin: 0 0 var(--space-1);
		}

		.results-panel__hint {
			font-size: var(--text-small);
			color: var(--text-faded);
			margin: 0 0 var(--space-3);
		}

		/* Category accordion rows: a real <details>/<summary>, so open/close,
		   keyboard support, and focus handling all come from the browser for
		   free. Every rule below targeting a JS-created class needs :global()
		   (Astro's scoped styles only tag elements present at build time; see
		   design.md's note on this). */
		:global(.category-row) {
			border-bottom: var(--border-width) solid var(--border);
		}
		:global(.category-rows .category-row:last-of-type) {
			border-bottom: none;
		}

		:global(.category-summary) {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-2);
			min-height: 2.75rem;
			padding: var(--space-2) 0;
			cursor: pointer;
			list-style: none;
		}
		:global(.category-summary::-webkit-details-marker) {
			display: none;
		}
		:global(.category-summary::marker) {
			content: "";
		}

		:global(.category-summary__label) {
			font-weight: var(--primary-medium);
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}

		:global(.category-summary__icon) {
			display: inline-flex;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			align-items: center;
			justify-content: center;
			font-size: 11px;
			font-weight: var(--primary-bold);
			color: var(--background-2);
			flex-shrink: 0;
		}
		:global(.category-summary__icon[data-status="pass"]) {
			background: var(--success);
		}
		:global(.category-summary__icon[data-status="fail"]) {
			background: var(--error);
		}
		:global(.category-summary__icon[data-status="info"]) {
			background: var(--text-faded);
		}

		:global(.category-summary__value) {
			font-weight: var(--primary-bold);
			color: var(--text-faded);
			font-size: var(--text-small);
			white-space: nowrap;
		}

		:global(.category-summary__chevron) {
			flex-shrink: 0;
			width: 0.6em;
			height: 0.6em;
			border-right: var(--border-width) solid var(--text-faded);
			border-bottom: var(--border-width) solid var(--text-faded);
			transform: rotate(45deg);
			transition: transform 200ms;
			margin-right: 0.2em;
		}
		:global(.category-row[open] .category-summary__chevron) {
			transform: rotate(225deg);
			margin-right: 0;
			margin-top: 0.3em;
		}

		:global(.category-body) {
			padding: 0 0 var(--space-3);
			font-size: var(--text-small);
			color: var(--text-faded);
		}
		:global(.category-body__text) {
			margin: 0 0 var(--space-2);
		}
		:global(.category-body__text strong) {
			color: var(--text);
		}
		:global(.category-body__subheading) {
			font-weight: var(--primary-bold);
			color: var(--text);
			text-transform: uppercase;
			font-size: var(--text-micro);
			letter-spacing: 0.04em;
			margin: var(--space-3) 0 var(--space-1);
		}

		:global(.category-facts) {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
		}
		:global(.category-facts__item) {
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}
		:global(.category-facts__mark) {
			display: inline-flex;
			width: 14px;
			height: 14px;
			flex-shrink: 0;
			align-items: center;
			justify-content: center;
			font-size: 10px;
			border-radius: 50%;
			color: var(--background-2);
		}
		:global(.category-facts__mark[data-status="pass"]) {
			background: var(--success);
		}
		:global(.category-facts__mark[data-status="fail"]) {
			background: var(--border);
			color: var(--text-faded);
		}

		:global(.category-sources) {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: var(--space-1);
		}
		:global(.category-sources a) {
			color: var(--text);
			text-decoration: underline;
			text-decoration-color: var(--border);
			text-underline-offset: 0.2em;
		}
		:global(.category-sources a:hover) {
			text-decoration-color: var(--text);
		}

		:global(.category-body--fallback) {
			padding-top: var(--space-3);
		}

		@media (max-width: 480px) {
			/* Most rows ("Crawler Access — 100/100") fit one line at this width
			   and should stay that way. Only the longer failing rows ("35/100 ·
			   Needs attention") need to wrap; when they do, right-align the
			   value + chevron on their own line instead of stranding the value
			   flush left. */
			:global(.category-summary) {
				flex-wrap: wrap;
			}
			:global(.category-summary__value) {
				margin-left: auto;
			}
		}

		.disclaimer {
			max-width: 40rem;
			margin: var(--space-6) auto 0;
			color: var(--text-faded);
			font-size: var(--text-micro);
			text-align: center;
		}
  </style>
</BaseLayout>

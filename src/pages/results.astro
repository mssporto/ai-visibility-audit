---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Results" description="AEO/GEO visibility audit results.">
	<Section paddingTop="small" paddingBottom="small" class="results">
		<div class="results__inner">
			<div id="loading-state" class="loading-state">
				<p class="loading-state__text">
					Examining <span id="loading-url" class="loading-state__url"></span>…
				</p>
			</div>

			<div id="error-state" class="error-state" hidden role="alert">
				<p id="error-message" class="error-state__message"></p>
				<ButtonWrapper class="alignment-center">
					<Button element="link" href="/" variant="link" class="cta-link">
						← Back to audit
					</Button>
				</ButtonWrapper>
			</div>

			<div id="dashboard" class="dashboard" hidden>
				<p id="blocked-banner" class="blocked-banner" hidden role="alert"></p>

				<div class="score-cards">
					<div class="score-card">
						<span class="score-card__label">AEO score</span>
						<span id="aeo-score" class="score-card__value">—</span>
						<div class="progress-bar">
							<div id="aeo-bar" class="progress-bar__fill"></div>
						</div>
					</div>
					<div class="score-card">
						<span class="score-card__label">GEO score</span>
						<span id="geo-score" class="score-card__value">—</span>
						<div class="progress-bar">
							<div id="geo-bar" class="progress-bar__fill"></div>
						</div>
					</div>
				</div>

				<p id="verdict-line" class="dashboard__verdict"></p>

				<div class="results-panel">
					<Heading tag="h2" class="results-panel__heading">Lab results</Heading>
					<div id="lab-rows" class="data-rows"></div>
				</div>

				<ButtonWrapper>
					<Button element="link" href="/" variant="link" class="cta-link">
						Run another audit →
					</Button>
				</ButtonWrapper>
			</div>
		</div>
	</Section>

	<script>
		import "../scripts/results-ui";
	</script>

	<style>
		:global(.results .container) {
			max-width: var(--dashboard-max-width);
		}

		.results__inner {
			width: 100%;
		}

		/* Button's "link" variant is deliberately thin (no min-height) — this
		   restores the 44px touch target without editing the shared component. */
		:global(.cta-link) {
			min-height: 2.75rem;
		}

		.loading-state {
			text-align: center;
			padding: var(--space-8) 0;
			color: var(--text-faded);
			font-size: var(--text-body);
		}
		.loading-state__url {
			color: var(--text);
			font-weight: var(--primary-bold);
			word-break: break-all;
		}

		.error-state {
			text-align: center;
			padding: var(--space-8) var(--space-3);
			background: var(--error-background);
			border: var(--border-width) solid var(--error);
			border-radius: var(--radius-small);
		}
		.error-state__message {
			color: var(--error);
			font-weight: var(--primary-bold);
			margin: 0 0 var(--space-2);
		}

		.blocked-banner {
			background: var(--error-background);
			color: var(--error);
			border: var(--border-width) solid var(--error);
			border-radius: var(--radius-small);
			padding: var(--space-2) var(--space-3);
			font-weight: var(--primary-bold);
			margin: 0 0 var(--space-3);
		}

		.score-cards {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: var(--space-3);
			margin-bottom: var(--space-4);
		}

		.score-card {
			background: var(--background-2);
			border: 2px solid var(--text);
			border-radius: var(--radius-small);
			padding: var(--space-3);
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: var(--space-1);
		}

		.score-card__label {
			font-size: var(--text-small);
			font-weight: var(--primary-bold);
			color: var(--text-faded);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.score-card__value {
			font-size: var(--text-score);
			font-weight: var(--primary-bold);
			line-height: var(--line-height-small);
			color: var(--text);
		}

		.progress-bar {
			width: 100%;
			height: 0.5rem;
			background: var(--border);
			border-radius: var(--radius-round);
			overflow: hidden;
			margin-top: var(--space-1);
		}

		:global(.progress-bar__fill) {
			height: 100%;
			border-radius: var(--radius-round);
			background: var(--success);
			transition: width 400ms cubic-bezier(0.16, 1, 0.3, 1);
		}
		:global(.progress-bar__fill[data-status="fail"]) {
			background: var(--error);
		}

		.dashboard__verdict {
			font-size: var(--text-body);
			color: var(--text-faded);
			text-align: center;
			margin: 0 0 var(--space-4);
		}

		.results-panel {
			background: var(--background-2);
			border: var(--border-width) solid var(--border);
			border-radius: var(--radius-small);
			padding: var(--space-4);
		}

		:global(.results-panel__heading) {
			font-size: var(--text-title);
			letter-spacing: var(--letter-spacing-tight);
			margin: 0 0 var(--space-3);
		}

		:global(.data-row) {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-2);
			padding: var(--space-2) 0;
			border-bottom: var(--border-width) solid var(--border);
		}
		:global(.data-row:last-of-type) {
			border-bottom: none;
		}

		:global(.data-row__label) {
			font-weight: var(--primary-medium);
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}

		:global(.data-row__icon) {
			display: inline-flex;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			align-items: center;
			justify-content: center;
			font-size: 11px;
			font-weight: var(--primary-bold);
			color: var(--background-2);
			flex-shrink: 0;
		}
		:global(.data-row__icon[data-status="pass"]) {
			background: var(--success);
		}
		:global(.data-row__icon[data-status="fail"]) {
			background: var(--error);
		}

		:global(.data-row__value) {
			font-weight: var(--primary-bold);
			color: var(--text-faded);
			font-size: var(--text-small);
		}

		:global(.data-row__detail) {
			border-bottom: var(--border-width) solid var(--border);
			padding: 0 0 var(--space-2);
			margin: 0 0 var(--space-1);
			font-size: var(--text-small);
			color: var(--text-faded);
		}
		:global(.data-row__detail p) {
			margin: var(--space-1) 0;
		}
		:global(.data-row__detail strong) {
			color: var(--text);
		}

		@media (max-width: 480px) {
			:global(.data-row) {
				flex-wrap: wrap;
			}
		}
	</style>
</BaseLayout>

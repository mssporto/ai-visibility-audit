---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Results — AI Visibility Audit"
	description="AEO/GEO visibility audit results."
>
	<section class="results">
		<div class="results__inner">
			<div id="loading-state" class="loading-state">
				<p class="loading-state__text">
					Examining <span id="loading-url" class="loading-state__url"></span>…
				</p>
			</div>

			<div id="error-state" class="error-state" hidden role="alert">
				<p id="error-message" class="error-state__message"></p>
				<a href="/" class="error-state__link">← Back to audit</a>
			</div>

			<div id="dashboard" class="dashboard" hidden>
				<p id="blocked-banner" class="blocked-banner" hidden role="alert"></p>

				<div class="score-cards">
					<div class="score-card">
						<span class="score-card__label">AEO score</span>
						<span id="aeo-score" class="score-card__value">—</span>
						<div class="progress-bar">
							<div id="aeo-bar" class="progress-bar__fill"></div>
						</div>
					</div>
					<div class="score-card">
						<span class="score-card__label">GEO score</span>
						<span id="geo-score" class="score-card__value">—</span>
						<div class="progress-bar">
							<div id="geo-bar" class="progress-bar__fill"></div>
						</div>
					</div>
				</div>

				<p id="verdict-line" class="dashboard__verdict"></p>

				<div class="results-panel">
					<h2 class="results-panel__heading">Lab results</h2>
					<div id="lab-rows" class="data-rows"></div>
				</div>

				<a href="/" class="dashboard__rerun">Run another audit →</a>
			</div>
		</div>
	</section>

	<script>
		import "../scripts/results-ui";
	</script>

	<style>
		.results {
			padding: var(--space-6) var(--space-3);
		}

		.results__inner {
			max-width: var(--dashboard-max-width);
			margin: 0 auto;
		}

		.loading-state {
			text-align: center;
			padding: var(--space-8) 0;
			color: var(--ink-secondary);
			font-size: var(--text-body);
		}
		.loading-state__url {
			color: var(--ink);
			font-weight: 600;
			word-break: break-all;
		}

		.error-state {
			text-align: center;
			padding: var(--space-8) var(--space-3);
			background: #fef2f2;
			border: 1px solid var(--error);
			border-radius: var(--radius);
		}
		.error-state__message {
			color: var(--error);
			font-weight: 600;
			margin: 0 0 var(--space-2);
		}
		.error-state__link {
			color: var(--ink);
			font-weight: 600;
			text-decoration: underline;
		}

		.blocked-banner {
			background: #fef2f2;
			color: var(--error);
			border: 1px solid var(--error);
			border-radius: var(--radius);
			padding: var(--space-2) var(--space-3);
			font-weight: 700;
			margin: 0 0 var(--space-3);
		}

		.score-cards {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: var(--space-3);
			margin-bottom: var(--space-4);
		}

		.score-card {
			background: var(--surface);
			border: 2px solid var(--ink);
			border-radius: var(--radius);
			padding: var(--space-3);
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: var(--space-1);
		}

		.score-card__label {
			font-size: var(--text-small);
			font-weight: 600;
			color: var(--ink-secondary);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.score-card__value {
			font-size: var(--text-score);
			font-weight: 800;
			line-height: 1;
			color: var(--ink);
		}

		.progress-bar {
			width: 100%;
			height: 0.5rem;
			background: var(--border);
			border-radius: var(--radius-pill);
			overflow: hidden;
			margin-top: var(--space-1);
		}

		:global(.progress-bar__fill) {
			height: 100%;
			border-radius: var(--radius-pill);
			background: var(--success);
			transition: width 400ms cubic-bezier(0.16, 1, 0.3, 1);
		}
		:global(.progress-bar__fill[data-status="fail"]) {
			background: var(--error);
		}

		.dashboard__verdict {
			font-size: var(--text-body);
			color: var(--ink-secondary);
			text-align: center;
			margin: 0 0 var(--space-4);
		}

		.results-panel {
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius);
			padding: var(--space-4);
		}

		.results-panel__heading {
			font-size: var(--text-title);
			font-weight: 700;
			letter-spacing: -0.01em;
			margin: 0 0 var(--space-3);
		}

		:global(.data-row) {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-2);
			padding: var(--space-2) 0;
			border-bottom: 1px solid var(--border);
		}
		:global(.data-row:last-of-type) {
			border-bottom: none;
		}

		:global(.data-row__label) {
			font-weight: 500;
			display: flex;
			align-items: center;
			gap: var(--space-2);
		}

		:global(.data-row__icon) {
			display: inline-flex;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			align-items: center;
			justify-content: center;
			font-size: 11px;
			font-weight: 800;
			color: #fff;
			flex-shrink: 0;
		}
		:global(.data-row__icon[data-status="pass"]) {
			background: var(--success);
		}
		:global(.data-row__icon[data-status="fail"]) {
			background: var(--error);
		}

		:global(.data-row__value) {
			font-weight: 700;
			color: var(--ink-secondary);
			font-size: var(--text-small);
		}

		:global(.data-row__detail) {
			border-bottom: 1px solid var(--border);
			padding: 0 0 var(--space-2);
			margin: 0 0 var(--space-1);
			font-size: var(--text-small);
			color: var(--ink-secondary);
		}
		:global(.data-row__detail p) {
			margin: var(--space-1) 0;
		}
		:global(.data-row__detail strong) {
			color: var(--ink);
		}

		.dashboard__rerun {
			display: inline-block;
			margin-top: var(--space-4);
			font-weight: 600;
			color: var(--ink);
			text-decoration: underline;
		}

		@media (max-width: 480px) {
			.data-row {
				flex-wrap: wrap;
			}
		}
	</style>
</BaseLayout>
